__pycache__/
*.pyc
.venv/
venv/
.env

# Datos: no se versionan. La tabla del modelo se arma con exportacion/ y no es
# publica (ver datos/DICCIONARIO.md, "Limites"). Tampoco predicciones por cliente.
*.csv
*.parquet
*.xlsx
*.json
!datos/manifiesto.json
!modelo/resultados/*.json
!modelo/exportado/*.json

# Modelos entrenados y archivos de trabajo de CatBoost
catboost_info/
*.cbm
*.pkl
*.joblib

scratch*

# El zip de hallazgos se arma con git archive; no se versiona.
*.zip


# Material de la defensa y consigna (decisiones del usuario, 2026-11-20 y 2026-11-22).
# De la presentación se versiona solo lo necesario para abrirla: el HTML (trae el video
# adentro), el video suelto con sus subtítulos y el LEEME. Los guiones, el PDF de respaldo,
# los scripts y la versión anterior quedan en la máquina del equipo.
presentacion/*
!presentacion/presentacion.html
!presentacion/video_datos.mp4
!presentacion/video_datos.srt
!presentacion/LEEME.txt
# Del informe se versiona el PDF entregado y lo necesario para volver a armarlo
# (py informe/armar_informe.py): el script, el HTML fuente y las fuentes con su licencia.
# Las figuras SVG y el HTML armado se generan.
informe/*
!informe/informe.pdf
!informe/armar_informe.py
!informe/fuente/
informe/fuente/*
!informe/fuente/informe.html
!informe/fuente/fuentes/
consigna.pdf
PropuestaProyectoML_Grupo6.pdf

# Registro que Chromium deja al exportar los PDF
debug.log
